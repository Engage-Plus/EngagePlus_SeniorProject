# Copy to .env and fill in. Never commit .env.

# Database (Supabase -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engageplus
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/engageplus

# Supabase Storage (flyers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FLYER_BUCKET=flyers

# Microsoft login (see 02-auth/microsoft-login-plan.md)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/organizations
MS_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback
# GUID from https://login.microsoftonline.com/howard.edu/v2.0/.well-known/openid-configuration (issuer)
HOWARD_TENANT_ID=

# Local development only — never true in production
DEV_AUTH=true

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Email (F7, F23, org email codes)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Cron jobs
JOBS_SECRET=change-me

# App
TZ_DEFAULT=America/New_York
SEMESTER_STARTS=
